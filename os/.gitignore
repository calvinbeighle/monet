# .gitignore for monet/os/
#
# Excludes secrets and generated files from version control.

# Environment files - NEVER commit these
.env
.env.local
.env.*.local
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Flutter / Dart build artifacts
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
*.freezed.dart
*.g.dart
build/

# Node.js
node_modules/
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/
