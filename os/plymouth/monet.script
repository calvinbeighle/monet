// Monet Plymouth Boot Splash Theme
// Displays the Monet wordmark centered on a dark background with a fade-in.
// Place this file at: /usr/share/plymouth/themes/monet/monet.script
// Place monet.plymouth alongside it.
//
// To activate:
//   sudo update-alternatives --install /usr/share/plymouth/themes/default.plymouth \
//     default.plymouth /usr/share/plymouth/themes/monet/monet.plymouth 100
//   sudo update-initramfs -u

// ---------------------------------------------------------------------------
// Background
// ---------------------------------------------------------------------------

Window.SetBackgroundTopColor(0.035, 0.035, 0.043);     // #09090b top
Window.SetBackgroundBottomColor(0.035, 0.035, 0.043);  // #09090b bottom

// ---------------------------------------------------------------------------
// Logo image
// ---------------------------------------------------------------------------
// Expects logo.png (128x128) converted from logo.svg in the theme directory.
// Convert with: inkscape -w 128 -h 128 logo.svg -o logo.png

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);

logo_x = Window.GetWidth()  / 2 - logo_image.GetWidth()  / 2;
logo_y = Window.GetHeight() / 2 - logo_image.GetHeight() / 2 - 40;

logo_sprite.SetPosition(logo_x, logo_y, 1);
logo_sprite.SetOpacity(0);

// ---------------------------------------------------------------------------
// Wordmark text
// ---------------------------------------------------------------------------

text_image = Image.Text("MONET", 1.0, 1.0, 1.0, 1, "Sans 18");
text_sprite = Sprite(text_image);

text_x = Window.GetWidth()  / 2 - text_image.GetWidth()  / 2;
text_y = logo_y + logo_image.GetHeight() + 20;

text_sprite.SetPosition(text_x, text_y, 1);
text_sprite.SetOpacity(0);

// ---------------------------------------------------------------------------
// Loading dots
// ---------------------------------------------------------------------------

dot_spacing = 12;
dot_count   = 3;
dot_size    = 6;
dot_sprites = [];
dot_images  = [];

fun MakeDot(alpha) {
  img = Image(dot_size, dot_size);
  // Draw a simple filled circle approximation via a solid square - Plymouth
  // Script does not have arc primitives. A small square reads fine at this size.
  for (py = 0; py < dot_size; py++) {
    for (px = 0; px < dot_size; px++) {
      dx = px - dot_size / 2;
      dy = py - dot_size / 2;
      if (Math.Sqrt(dx * dx + dy * dy) <= dot_size / 2) {
        img.DrawPixel(px, py, 0.545, 0.361, 0.965, alpha); // violet #8b5cf6
      }
    }
  }
  return img;
}

dots_total_w = dot_count * dot_size + (dot_count - 1) * dot_spacing;
dots_start_x = Window.GetWidth() / 2 - dots_total_w / 2;
dots_y       = text_y + text_image.GetHeight() + 18;

for (i = 0; i < dot_count; i++) {
  dot_images[i]  = MakeDot(0.25);
  dot_sprites[i] = Sprite(dot_images[i]);
  dot_sprites[i].SetPosition(dots_start_x + i * (dot_size + dot_spacing), dots_y, 1);
  dot_sprites[i].SetOpacity(0);
}

// ---------------------------------------------------------------------------
// Animation state
// ---------------------------------------------------------------------------

progress       = 0.0;    // 0..1 for fade-in
pulse_tick     = 0;
active_dot     = 0;
pulse_period   = 30;     // frames per dot advance

// ---------------------------------------------------------------------------
// Refresh callback - called each frame by Plymouth
// ---------------------------------------------------------------------------

fun refresh_callback() {
  // Fade in logo and text over ~60 frames
  if (progress < 1.0) {
    progress = progress + 0.025;
    if (progress > 1.0) { progress = 1.0; }
    logo_sprite.SetOpacity(progress);
    text_sprite.SetOpacity(progress * 0.82);
    for (i = 0; i < dot_count; i++) {
      dot_sprites[i].SetOpacity(progress * 0.25);
    }
  }

  // Pulse dots
  pulse_tick = pulse_tick + 1;
  if (pulse_tick >= pulse_period) {
    pulse_tick  = 0;
    active_dot  = (active_dot + 1) % dot_count;
    for (i = 0; i < dot_count; i++) {
      if (i == active_dot) {
        dot_sprites[i].SetOpacity(progress * 1.0);
      } else {
        dot_sprites[i].SetOpacity(progress * 0.25);
      }
    }
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

// ---------------------------------------------------------------------------
// Boot progress (password prompt stub - just hide if shown)
// ---------------------------------------------------------------------------

fun display_normal_callback() {
  // Nothing extra needed for normal boot
}

fun display_password_callback(prompt, bullets) {
  // Minimal: do nothing, let default behavior apply
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
