# Monet OS - Sway configuration
# Launches the Monet Flutter shell fullscreen with no desktop chrome.

# ---------------------------------------------------------------------------
# Display and output
# ---------------------------------------------------------------------------

# Use all available outputs at native resolution
output * bg #0A0A0F solid_color

# ---------------------------------------------------------------------------
# Monet shell - the entire UI
# ---------------------------------------------------------------------------

# Launch the Monet Flutter shell on startup
exec /opt/monet/shell/shell

# Make the Flutter shell window fullscreen with no decorations
for_window [app_id="shell"] {
    fullscreen enable
    border none
}

# Fallback: catch by title if app_id doesn't match
for_window [title="Monet"] {
    fullscreen enable
    border none
}

# Make all windows borderless by default (safety net)
default_border none
default_floating_border none

# ---------------------------------------------------------------------------
# Disable all desktop chrome
# ---------------------------------------------------------------------------

# No status bar
bar {
    mode invisible
}

# No window titlebars
titlebar_border_thickness 0
titlebar_padding 0

# ---------------------------------------------------------------------------
# Input configuration
# ---------------------------------------------------------------------------

# Natural scrolling for touchpad
input type:touchpad {
    natural_scroll enabled
    tap enabled
    dwt enabled
}

# Keyboard repeat rate
input type:keyboard {
    repeat_delay 300
    repeat_rate 30
}

# ---------------------------------------------------------------------------
# Essential keybindings only
# ---------------------------------------------------------------------------

# Modifier key (Super/Logo)
set $mod Mod4

# Emergency terminal (for debugging - remove in production)
bindsym $mod+Return exec foot

# Reload Sway config
bindsym $mod+Shift+c reload

# Exit Sway (shutdown/logout)
bindsym $mod+Shift+e exec swaynag -t warning \
    -m 'Exit Monet?' \
    -B 'Shutdown' 'systemctl poweroff' \
    -B 'Restart' 'systemctl reboot' \
    -B 'Exit to TTY' 'swaymsg exit'

# Screenshot (for debugging)
bindsym Print exec grim ~/screenshot-$(date +%Y%m%d-%H%M%S).png

# ---------------------------------------------------------------------------
# Idle and lock
# ---------------------------------------------------------------------------

# Lock after 5 minutes idle, turn off display after 10 minutes
exec swayidle -w \
    timeout 300 'swaylock -f -c 0A0A0F' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"'

# Lock screen background matches Monet theme
# swaylock will use solid color 0A0A0F (near-black)

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

# Wayland-native rendering
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
