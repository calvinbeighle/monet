# Nango OAuth configuration (required for Gmail integration)
# See Spec 01 - Email Integration for details.
VITE_NANGO_SECRET_KEY=your-nango-secret-key
VITE_NANGO_HOST=https://api.nango.dev
VITE_NANGO_GMAIL_CONNECTION_ID=gmail

# Anthropic API key (optional - enables AI-powered agent backend)
# Without this key, agents fall back to simulated proposals.
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key
